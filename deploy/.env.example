# Copier en deploy/.env puis remplir. Ce fichier ne doit jamais être versionné.

# Nom de domaine pointant vers le serveur (enregistrement DNS A)
KOBR4_DOMAIN=kobr4.exemple.fr
KOBR4_PUBLIC_URL=https://kobr4.exemple.fr

# Clé maîtresse qui chiffre les jetons courtier et Telegram en base.
# Générer : docker compose run --rm app kobr4 server gen-key
# À SAUVEGARDER hors du serveur : sans elle, les jetons enregistrés sont perdus.
KOBR4_MASTER_KEY=

# Mot de passe de la base (long et aléatoire : openssl rand -base64 32)
POSTGRES_PASSWORD=

# Inscription : le premier compte est libre ; ensuite, code d'invitation obligatoire.
KOBR4_INVITE_CODE=

# Jours minimum en démo avant de pouvoir passer un bot en réel
KOBR4_MIN_PAPER_DAYS=28

# Jeton pour Prometheus (même valeur que deploy/secrets/metrics_token)
KOBR4_METRICS_TOKEN=

# Sauvegardes
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
